<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Contenedor con la información de negocio del registro -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ubicación / Sector -->
            <TextView
                android:id="@+id/txtUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sector Norte"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Métricas rotuladas con lenguaje de negocio -->
            <TextView
                android:id="@+id/txtMetricas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Humedad: 65.0% - Temp: 22.0°C"
                android:textColor="#333333"
                android:textSize="15sp" />

            <!-- Indicador de estado de ventilación -->
            <TextView
                android:id="@+id/txtEstadoVentilacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estado: Ventilación en Espera"
                android:textColor="#757575"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Botón de eliminar con ícono de basura -->
        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar registro de invernadero"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#F44336" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
